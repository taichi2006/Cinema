# PostgreSQL: bắt buộc khi khởi động ứng dụng
DB_URL=jdbc:postgresql://localhost:5432/cinema
DB_USERNAME=cinema_app
DB_PASSWORD=replace-with-a-rotated-secret

# VNPAY: bắt buộc khi người dùng chọn VNPAY
VNPAY_TMN_CODE=replace-with-merchant-code
VNPAY_HASH_SECRET=replace-with-hash-secret
