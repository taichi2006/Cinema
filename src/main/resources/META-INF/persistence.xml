<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="
                 https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">

    <persistence-unit
            name="cinemaPU"
            transaction-type="RESOURCE_LOCAL">

        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>
        <class>com.cinema.movie.Movie</class>
        <class>com.cinema.movie.Review</class>
        <class>com.cinema.cinema.Cinema</class>
        <class>com.cinema.cinema.Room</class>
        <class>com.cinema.user.entity.User</class>
        <!-- Module Wallet: Ví người dùng, nạp tiền và lịch sử bút toán giao dịch -->
        <class>com.cinema.wallet.entity.Wallet</class>
        <class>com.cinema.wallet.entity.WalletTransaction</class>
        <!-- Module Product: Danh mục sản phẩm F&B -->
        <class>com.cinema.product.Product</class>
        <!-- Module Ticket: Vé xem phim điện tử -->
        <class>com.cinema.ticket.Ticket</class>
        <!-- Module Showtime & Seat -->
        <class>com.cinema.showtime.Showtime</class>
        <class>com.cinema.showtime.Seat</class>
        <class>com.cinema.showtime.ShowtimeSeat</class>
        <!-- Module Voucher -->
        <class>com.cinema.voucher.Voucher</class>
        <!-- Module Booking -->
        <class>com.cinema.booking.entity.Booking</class>
        <class>com.cinema.booking.entity.BookingItem</class>
        <class>com.cinema.booking.entity.Refund</class>
        <!-- Module Payment -->
        <class>com.cinema.payment.entity.Payment</class>

        <properties>
            <!-- Cấu hình kết nối CSDL (URL, user, password) được nạp động qua DB.java (.env) -->
            <property
                    name="hibernate.dialect"
                    value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property
                    name="hibernate.default_schema"
                    value="cinema"/>

            <property
                    name="hibernate.show_sql"
                    value="true"/>

            <!-- HikariCP settings -->
            <property name="hibernate.connection.provider_class" value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>
            <property name="hibernate.hikari.minimumIdle" value="5"/>
            <property name="hibernate.hikari.maximumPoolSize" value="20"/>
            <property name="hibernate.hikari.idleTimeout" value="30000"/>

        </properties>

    </persistence-unit>

</persistence>
